{
  "name": "@relay/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.3.0",
    "@opentelemetry/auto-instrumentations-node": "^0.62.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.203.0",
    "@opentelemetry/sdk-node": "^0.203.0",
    "@relay/adapters": "workspace:*",
    "@relay/contracts": "workspace:*",
    "@relay/orchestrator": "workspace:*",
    "@relay/tool-runner": "workspace:*",
    "@relay/workers": "workspace:*",
    "dotenv": "^16.5.0",
    "fastify": "^5.4.0",
    "pg": "^8.16.3"
  },
  "devDependencies": { "@types/node": "^22.15.32", "@types/pg": "^8.15.4", "tsx": "^4.20.3", "typescript": "^5.8.3" }
}
